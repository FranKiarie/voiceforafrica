# Server only. Never prefix these with VITE_ and never commit real values.
# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paystack secret key. Use sk_test_... until a real M-Pesa payment works, then sk_live_...
# https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=

# Optional. Full-quality WAV storage so a paid clip survives a refresh.
# Vercel project → Storage → Blob → connect the store. Vercel fills this in.
# BLOB_READ_WRITE_TOKEN=

# Optional. Public site URL Paystack may redirect back to. Defaults to the request host.
# APP_URL=https://voice.mikaka.io

# Optional. Override the TTS model. Default is gemini-3.8-flash-tts.
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Client. Leave unset in production.
# demo = studio UI with no audio and no charges. live (default) calls /api on this site.
# VITE_API_MODE=demo

# Not required. Checkout resumes a transaction the server already priced.
# VITE_PAYSTACK_PUBLIC_KEY=pk_live_...
